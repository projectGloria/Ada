{
  "productName": "Ada",
  "version": "0.1.0",
  "identifier": "com.projectgloria.ada",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Ada",
      "width": 1180,
      "height": 780,
      "minWidth": 560,
      "minHeight": 510,
      "decorations": false,
      "backgroundColor": "#201d19"
    }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
